FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir torch torchvision --index-url https://pytorch.org && pip install --no-cache-dir ultralytics opencv-python-headless flask

COPY . .

CMD ["python", "main.py"]
